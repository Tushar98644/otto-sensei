# Every variable the app reads. Names only: real values go in .env.local (git-ignored) and in
# Vercel. SETUP.md says where each value comes from.
#
# Nothing is needed for `bun dev`: it uses a local database (.pglite/) and shows sign-in codes on
# screen. The Supabase values below only matter in development with DEV_AUTH=supabase.

# Public site URL for links, sitemap, OG tags and the Google sign-in return address. On Vercel it
# falls back to https://$VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Supabase. Each value has two accepted names: the first is what you set by hand for a project made
# at supabase.com; the second is what the Vercel Marketplace / Supabase integration creates.
# Postgres, pooled (Supabase "Transaction pooler", port 6543). The app's only connection.
DATABASE_URL=
# POSTGRES_URL=
# Postgres, unpooled (Supabase "Session pooler", port 5432). Only scripts/migrate.ts uses it.
DIRECT_DATABASE_URL=
# POSTGRES_URL_NON_POOLING=
# Project URL, https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy anon key works too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (sb_secret_...), used to delete accounts. The legacy service_role key
# works too. Never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Development only. "supabase": sign in through Supabase (real email codes, Google) and use
# DATABASE_URL, instead of on-screen codes and the local database. Ignored in production.
DEV_AUTH=
# Development only: signs dev-mode session cookies. Optional; a fixed dev secret is used without it.
AUTH_SECRET=

# OpenRouter (openrouter.ai/keys). Without it, import uses the rule-based parser and Otto's
# fixes/tailoring use demo output.
OPENROUTER_API_KEY=
# OpenRouter model slugs with structured outputs + reasoning. AI_MODEL (line fixes and tailoring)
# and AI_STRUCTURE_MODEL (sorting an imported resume into sections) both default to
# z-ai/glm-5.3-flash (about $0.15 in / $0.50 out per million tokens). Any OpenRouter model with
# structured outputs works, e.g. z-ai/glm-5.3 or anthropic/claude-opus-5.5 ($4/$20, far pricier).
AI_MODEL=
AI_STRUCTURE_MODEL=

# "Import from GitHub" (optional). Works without it: GitHub then allows this server 60 calls an
# hour, shared by everyone (one lookup uses 2, one draft up to 10). A fine-grained token with
# "Public repositories (read-only)" and no other permissions raises that to 5,000.
GITHUB_TOKEN=

# Creem (merchant of record). Without the key, secret and Pro monthly product: mock upgrades and
# a mock trial in development, billing off in production. Keys and products belong to one Creem
# environment: CREEM_TEST_MODE=true (the default) uses test-api.creem.io with test keys; set it to
# false with live keys for real payments.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
# One product per plan and billing interval. Prices are PRICES_USD in src/config/plans.ts (Pro
# $15/month, $120/year, $6/week; Max $29/month, $232/year, $12/week): keep them equal to what the
# Creem products charge. Pro monthly is required; each other option is offered only while its id
# is set.
CREEM_PRO_MONTHLY_PRODUCT_ID=
CREEM_PRO_YEARLY_PRODUCT_ID=
CREEM_PRO_WEEKLY_PRODUCT_ID=
CREEM_MAX_MONTHLY_PRODUCT_ID=
CREEM_MAX_YEARLY_PRODUCT_ID=
CREEM_MAX_WEEKLY_PRODUCT_ID=
# Pro monthly ($15) with a free 3-day trial, card required. New accounts are checked out on it
# once; anyone who has trialed or paid gets CREEM_PRO_MONTHLY_PRODUCT_ID. Without it, no trial.
CREEM_PRO_TRIAL_PRODUCT_ID=

# Sentry error reports (optional). Without a DSN nothing loads and nothing is sent. Off in
# development unless NEXT_PUBLIC_SENTRY_DEV=1. The public DSN is used by the browser and the
# server; SENTRY_DSN overrides it on the server only.
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DEV=
# Build only, for readable stack traces: source maps upload when the token is set.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog product analytics (optional). Without a key nothing loads and nothing is sent, in the
# browser or from the server. Always off in tests. The project key ("phc_...") can only write
# events, so it's safe in the browser. Host: https://us.i.posthog.com (default) or
# https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Scheduled jobs (optional): the daily cleanup and application follow-up reminders (vercel.json
# "crons"). Vercel Cron sends it as "Authorization: Bearer <secret>". Without it, or under 16
# characters, the jobs refuse to run. Also signs the one-click unsubscribe link in reminder
# emails. Make one with: openssl rand -hex 32
CRON_SECRET=
# Reminder emails through Resend (optional). Both are needed; without them reminders stay in the
# dashboard bell only. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
# EMAIL_FROM="Otto Resume <otto@yourdomain.com>"
EMAIL_FROM=
