{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "buildCommand": "bun run build && bun scripts/migrate.ts --deploy",
  "crons": [
    { "path": "/api/cron/cleanup", "schedule": "17 4 * * *" },
    { "path": "/api/cron/jobs?run=1", "schedule": "45 5 * * *" },
    { "path": "/api/cron/jobs?run=2", "schedule": "15 6 * * *" },
    { "path": "/api/cron/jobs?run=3", "schedule": "45 6 * * *" },
    { "path": "/api/cron/jobs?run=4", "schedule": "15 7 * * *" },
    { "path": "/api/cron/jobs?run=5", "schedule": "45 7 * * *" },
    { "path": "/api/cron/jobs?run=6", "schedule": "15 8 * * *" },
    { "path": "/api/cron/trial-reminders", "schedule": "30 13 * * *" },
    { "path": "/api/cron/follow-ups", "schedule": "0 14 * * *" },
    { "path": "/api/cron/job-matches", "schedule": "30 8 * * *" },
    { "path": "/api/cron/view-alerts", "schedule": "15 13 * * *" },
    { "path": "/api/cron/interview-briefs", "schedule": "37 2 * * *" },
    { "path": "/api/cron/career-checkins", "schedule": "30 12 * * *" }
  ]
}
